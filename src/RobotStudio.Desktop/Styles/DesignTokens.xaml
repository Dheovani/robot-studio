<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Color roles -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="SubtlePanelBackgroundBrush" Color="#122033" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="TagBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="TagTextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ModalOverlayBrush" Color="#D90B1220" />
    <SolidColorBrush x:Key="RobotCardBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="RobotCardHighlightBackgroundBrush" Color="#112037" />
    <SolidColorBrush x:Key="RobotCardPlannedBorderBrush" Color="#334155" />
    <SolidColorBrush x:Key="RobotCardPlannedHighlightBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="RobotCardAvailableBorderBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="RobotCardAvailableHighlightBorderBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="DropdownBackgroundBrush" Color="#121C2C" />
    <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Color="#1E3A5F" />
    <SolidColorBrush x:Key="SelectedItemTextBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="InformationHeadingBrush" Color="#BFDBFE" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#475569" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#7DD3FC" />
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#261F2937" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="AxisXBrush" Color="#F87171" />
    <SolidColorBrush x:Key="AxisYBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="AxisZBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="PositiveSeriesBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="NegativeSeriesBrush" Color="#F87171" />
    <SolidColorBrush x:Key="RequestedSeriesBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="EffectiveSeriesBrush" Color="#FACC15" />
    <SolidColorBrush x:Key="MechanicalInfoSurfaceBrush" Color="#182235" />

    <!-- Renderer colors are typed separately because Helix properties consume Color, not Brush. -->
    <Color x:Key="ViewportBackgroundColor">#0B1220</Color>
    <Color x:Key="AmbientLightColor">#748096</Color>
    <Color x:Key="KeyLightColor">#FFF4E6</Color>
    <Color x:Key="FillLightColor">#7EA6D8</Color>

    <!-- Control geometry -->
    <sys:Double x:Key="StandardControlHeight">36</sys:Double>
    <sys:Double x:Key="CompactControlHeight">34</sys:Double>
    <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="SmallCornerRadius">3</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <Thickness x:Key="ControlPadding">12,0</Thickness>
    <Thickness x:Key="InputPadding">10,6</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="CompactPanelPadding">12</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="BadgePadding">8,3</Thickness>
    <Thickness x:Key="CapabilityPadding">8,4</Thickness>
    <Thickness x:Key="PanelSectionSpacing">0,0,0,10</Thickness>
    <Thickness x:Key="SectionSpacing">0,18,0,0</Thickness>
    <Thickness x:Key="FieldSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>

    <!-- Typography scale -->
    <sys:Double x:Key="TitleFontSize">22</sys:Double>
    <sys:Double x:Key="DisplayTitleFontSize">30</sys:Double>
    <sys:Double x:Key="DialogTitleFontSize">24</sys:Double>
    <sys:Double x:Key="CardTitleFontSize">21</sys:Double>
    <sys:Double x:Key="SectionTitleFontSize">18</sys:Double>
    <sys:Double x:Key="PanelTitleFontSize">16</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="MetadataFontSize">12</sys:Double>
</ResourceDictionary>
