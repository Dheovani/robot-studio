<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="DesignTokens.xaml" />
    <ResourceDictionary Source="ControlStyles.xaml" />
</ResourceDictionary.MergedDictionaries>

<Style x:Key="ControlFocusVisualStyle">
    <Setter Property="Control.Template">
        <Setter.Value>
            <ControlTemplate>
                <Border Margin="-2"
                        BorderBrush="{StaticResource FocusBorderBrush}"
                        BorderThickness="{StaticResource FocusBorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}" />
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="ButtonBaseStyle" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource StandardControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource FocusBorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SubtleBorderBrush}" />
                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="PrimaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource AccentBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
</Style>

<Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />

<Style x:Key="SecondaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource SubtlePanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
</Style>

<Style x:Key="GhostButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
</Style>

<Style x:Key="ViewerHeaderStyle" TargetType="DockPanel">
    <Setter Property="Margin" Value="16,12,16,10" />
    <Setter Property="LastChildFill" Value="True" />
</Style>

<Style x:Key="ViewerTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="ViewerSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
</Style>

<Style x:Key="ViewerToolbarButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Width" Value="92" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="8,0,0,0" />
</Style>

<Style x:Key="ViewerNavigationButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource GhostButtonStyle}">
    <Setter Property="Width" Value="92" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="8,0,0,0" />
</Style>

<Style x:Key="ViewerViewportStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
</Style>

<Style x:Key="ViewerSidebarStyle" TargetType="Border">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Padding" Value="{StaticResource CompactPanelPadding}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
</Style>

<Style x:Key="ViewerSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="ShowsPreview" Value="True" />
    <Setter Property="Cursor" Value="SizeWE" />
</Style>

<Style x:Key="ViewerSectionHeadingStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource PanelTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="ViewerHelpTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
</Style>

<Style x:Key="ViewerStateGridStyle" TargetType="Grid">
    <Setter Property="Margin" Value="0,18,0,18" />
</Style>

<Style x:Key="ViewerSectionDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,16,0,16" />
    <Setter Property="Background" Value="{StaticResource SubtleBorderBrush}" />
</Style>

<Style x:Key="SidebarRailButtonStyle" TargetType="RadioButton">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="RailChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        <Setter TargetName="RailChrome" Property="Background" Value="{StaticResource SubtlePanelBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                        <Setter TargetName="RailChrome" Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                        <Setter TargetName="RailChrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="FlatSidebarSectionStyle" TargetType="Expander">
    <Setter Property="Margin" Value="0,0,0,22" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ContentPresenter ContentSource="Header"
                                      Margin="0,0,0,10"
                                      TextElement.FontSize="16"
                                      TextElement.FontWeight="SemiBold" />
                    <ContentPresenter ContentSource="Content"
                                      TextElement.FontSize="13"
                                      TextElement.FontWeight="Normal" />
                </StackPanel>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="ViewerScriptEditorStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="142" />
    <Setter Property="Margin" Value="0,10,0,10" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="AcceptsTab" Value="True" />
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
</Style>

<Style TargetType="Expander">
    <Setter Property="Margin" Value="{StaticResource PanelSectionSpacing}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource StandardControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource ControlFocusVisualStyle}" />
</Style>

<Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource SectionTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
</Style>

<Style x:Key="MetadataTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource MetadataFontSize}" />
    <Setter Property="TextWrapping" Value="Wrap" />
</Style>

<Style x:Key="AccentMetadataTextStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource MetadataTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
</Style>

<Style x:Key="ViewerStateLabelStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource FieldLabelTextStyle}" />

<Style x:Key="ViewerStateValueStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource BodyTextStyle}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="TextWrapping" Value="Wrap" />
</Style>

<Style x:Key="ViewerScriptFieldLabelStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource FieldLabelTextStyle}">
    <Setter Property="Margin" Value="0,10,0,4" />
</Style>

<Style x:Key="ViewerScriptStatusStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource ViewerHelpTextStyle}">
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="CatalogPageTitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource DisplayTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="CatalogCardTitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource CardTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="DialogTitleTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource DialogTitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="BadgeBorderStyle" TargetType="Border">
    <Setter Property="Padding" Value="{StaticResource BadgePadding}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
</Style>

<Style x:Key="BadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource MetadataFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="CapabilityBadgeBorderStyle"
       TargetType="Border"
       BasedOn="{StaticResource BadgeBorderStyle}">
    <Setter Property="Padding" Value="{StaticResource CapabilityPadding}" />
    <Setter Property="Background" Value="{StaticResource TagBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
</Style>

<Style x:Key="CapabilityBadgeTextStyle"
       TargetType="TextBlock"
       BasedOn="{StaticResource MetadataTextStyle}">
    <Setter Property="Foreground" Value="{StaticResource TagTextBrush}" />
</Style>

<Style x:Key="IconButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Width" Value="{StaticResource StandardControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
</Style>

<Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
</Style>

<Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
</Style>

<DataTemplate x:Key="GlossaryEntryTemplate">
    <Border Margin="0,0,0,10"
            Padding="{StaticResource PanelPadding}"
            Background="{StaticResource SubtlePanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource PanelCornerRadius}">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Style="{StaticResource BadgeBorderStyle}"
                        VerticalAlignment="Center"
                        Background="{StaticResource TagBackgroundBrush}"
                        BorderBrush="{StaticResource TagBorderBrush}">
                    <TextBlock Style="{StaticResource AccentMetadataTextStyle}"
                               Text="{Binding Category}" />
                </Border>
                <TextBlock Style="{StaticResource SectionTitleTextStyle}"
                           Text="{Binding DisplayTerm}" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource BodyTextStyle}"
                       LineHeight="20"
                       Text="{Binding Definition}" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource MetadataTextStyle}"
                       Text="{Binding RelatedTermsText}"
                       />
        </StackPanel>
    </Border>
</DataTemplate>

<Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>

<Style TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>
</ResourceDictionary>
