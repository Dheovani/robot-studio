<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="ControlStyles.xaml" />
</ResourceDictionary.MergedDictionaries>
<SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
<SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0F172A" />
<SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
<SolidColorBrush x:Key="SubtlePanelBackgroundBrush" Color="#122033" />
<SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB" />
<SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
<SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
<SolidColorBrush x:Key="BorderBrush" Color="#334155" />
<SolidColorBrush x:Key="SubtleBorderBrush" Color="#1E293B" />
<SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2563EB" />
<SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B82F6" />
<SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#60A5FA" />
<SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />
<Thickness x:Key="PanelSectionSpacing">0,0,0,10</Thickness>

<Style x:Key="ButtonBaseStyle" TargetType="Button">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Button">
                <Border x:Name="ButtonChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.88" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.72" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource ButtonHoverBorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                        <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SubtleBorderBrush}" />
                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="PrimaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
</Style>

<Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}" />

<Style x:Key="SecondaryButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{StaticResource SubtlePanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
</Style>

<Style x:Key="GhostButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
</Style>

<Style x:Key="ViewerHeaderStyle" TargetType="DockPanel">
    <Setter Property="Margin" Value="16,12,16,10" />
    <Setter Property="LastChildFill" Value="True" />
</Style>

<Style x:Key="ViewerTitleStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="ViewerSubtitleStyle" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="FontSize" Value="13" />
</Style>

<Style x:Key="ViewerToolbarButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource SecondaryButtonStyle}">
    <Setter Property="Width" Value="92" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="8,0,0,0" />
</Style>

<Style x:Key="ViewerNavigationButtonStyle"
       TargetType="Button"
       BasedOn="{StaticResource GhostButtonStyle}">
    <Setter Property="Width" Value="92" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="8,0,0,0" />
</Style>

<Style x:Key="ViewerViewportStyle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
</Style>

<Style x:Key="ViewerSidebarStyle" TargetType="Border">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="4" />
</Style>

<Style x:Key="ViewerSplitterStyle" TargetType="GridSplitter">
    <Setter Property="Width" Value="8" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="ShowsPreview" Value="True" />
    <Setter Property="Cursor" Value="SizeWE" />
</Style>

<Style x:Key="ViewerSectionHeadingStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style x:Key="ViewerHelpTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="TextWrapping" Value="Wrap" />
</Style>

<Style x:Key="ViewerSectionDividerStyle" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,16,0,16" />
    <Setter Property="Background" Value="{StaticResource SubtleBorderBrush}" />
</Style>

<Style x:Key="SidebarRailButtonStyle" TargetType="RadioButton">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="RailChrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        <Setter TargetName="RailChrome" Property="Background" Value="{StaticResource SubtlePanelBackgroundBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Foreground" Value="#93C5FD" />
                        <Setter TargetName="RailChrome" Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
                        <Setter TargetName="RailChrome" Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="FlatSidebarSectionStyle" TargetType="Expander">
    <Setter Property="Margin" Value="0,0,0,22" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
        <Setter.Value>
            <ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ContentPresenter ContentSource="Header"
                                      Margin="0,0,0,10"
                                      TextElement.FontSize="16"
                                      TextElement.FontWeight="SemiBold" />
                    <ContentPresenter ContentSource="Content"
                                      TextElement.FontSize="13"
                                      TextElement.FontWeight="Normal" />
                </StackPanel>
            </ControlTemplate>
        </Setter.Value>
    </Setter>
</Style>

<Style x:Key="ViewerScriptEditorStyle"
       TargetType="TextBox"
       BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Height" Value="142" />
    <Setter Property="Margin" Value="0,10,0,10" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="AcceptsTab" Value="True" />
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
</Style>

<Style TargetType="Expander">
    <Setter Property="Margin" Value="{StaticResource PanelSectionSpacing}" />
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
</Style>

<Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
</Style>

<Style TargetType="ListBox">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
</Style>

<Style TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
</Style>

<DataTemplate x:Key="GlossaryEntryTemplate">
    <Border Margin="0,0,0,10"
            Padding="14"
            Background="{StaticResource SubtlePanelBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        Padding="7,3"
                        VerticalAlignment="Center"
                        Background="#1E293B"
                        BorderBrush="#475569"
                        BorderThickness="1"
                        CornerRadius="3">
                    <TextBlock Foreground="#93C5FD"
                               FontSize="12"
                               Text="{Binding Category}" />
                </Border>
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Text="{Binding DisplayTerm}" />
            </DockPanel>
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       LineHeight="20"
                       Text="{Binding Definition}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       Text="{Binding RelatedTermsText}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</DataTemplate>

<Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>

<Style TargetType="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
</Style>
</ResourceDictionary>
