<UserControl x:Class="RobotStudio.Desktop.Viewers.ViewerTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewers="clr-namespace:RobotStudio.Desktop.Viewers">
    <Border Style="{DynamicResource ViewerTimelineSurfaceStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button Width="34"
                    Height="34"
                    Margin="0,0,8,0"
                    Padding="0"
                    Style="{DynamicResource GhostButtonStyle}"
                    Content="&#xE76B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    ToolTip="Move one playback frame backward."
                    AutomationProperties.Name="Previous frame"
                    Click="PreviousButton_Click" />
            <Button Width="34"
                    Height="34"
                    Margin="0,0,12,0"
                    Padding="0"
                    Style="{DynamicResource GhostButtonStyle}"
                    Content="&#xE76C;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="14"
                    ToolTip="Move one playback frame forward."
                    AutomationProperties.Name="Next frame"
                    Click="NextButton_Click" />
            <ComboBox x:Name="PlaybackSpeedComboBox"
                      Width="88"
                      ToolTip="Change the playback speed without changing simulated time."
                      AutomationProperties.Name="Playback speed"
                      SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                <ComboBoxItem Content="0.5x" Tag="0.5" />
                <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                <ComboBoxItem Content="2x" Tag="2" />
                <ComboBoxItem Content="4x" Tag="4" />
            </ComboBox>
        </StackPanel>

        <Slider x:Name="FrameSlider"
                Grid.Column="1"
                Margin="12,0,0,0"
                Minimum="0"
                IsSnapToTickEnabled="True"
                Style="{DynamicResource TimelineSliderStyle}"
                ValueChanged="FrameSlider_ValueChanged" />

        <StackPanel Grid.Column="2"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <viewers:PlaybackStateBadge x:Name="StateBadge"
                                        Margin="0,0,12,0" />
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextAlignment="Right" />
        </StackPanel>
    </Grid>
    </Border>
</UserControl>
