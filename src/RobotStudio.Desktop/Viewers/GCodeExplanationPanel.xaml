<UserControl x:Class="RobotStudio.Desktop.Viewers.GCodeExplanationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <StackPanel Margin="0,2,0,10">
        <CheckBox x:Name="ExplanationToggle"
                  Foreground="{StaticResource InformationHeadingBrush}"
                  Content="Explain G-code lines"
                  ToolTip="Show or hide a line-by-line explanation without modifying the script."
                  Checked="ExplanationToggle_Changed"
                  Unchecked="ExplanationToggle_Changed" />

        <Border x:Name="ExplanationContent"
                Margin="0,8,0,0"
                Padding="10"
                Background="{StaticResource HeaderBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <ItemsControl x:Name="ExplanationItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{StaticResource DisabledTextBrush}"
                                       FontFamily="Consolas"
                                       Text="{Binding LineNumber, StringFormat=\#{0}}" />
                            <TextBlock Grid.Column="1"
                                       Foreground="{StaticResource InfoTextBrush}"
                                       FontFamily="Consolas"
                                       FontWeight="SemiBold"
                                       Text="{Binding Command}" />
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding Explanation}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
