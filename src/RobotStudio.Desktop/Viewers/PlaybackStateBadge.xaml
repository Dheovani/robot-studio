<UserControl x:Class="RobotStudio.Desktop.Viewers.PlaybackStateBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="BadgeSurface"
            Padding="8,3"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <TextBlock x:Name="BadgeText"
                   FontSize="11"
                   FontWeight="SemiBold" />
    </Border>
</UserControl>
