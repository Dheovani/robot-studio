<Window x:Class="RobotStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:didactics="clr-namespace:RobotStudio.Desktop.Didactics"
        xmlns:viewers="clr-namespace:RobotStudio.Desktop.Viewers"
        Title="RobotStudio"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Icon="Assets/RobotStudio.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseWheel="MainWindow_PreviewMouseWheel">
    <Window.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="ViewerScriptActionsTemplate">
                <StackPanel>
                    <Button Margin="0,0,0,10"
                            Content="{DynamicResource Common.Simulate}"
                            Click="SimulateActiveScriptButton_Click" />
                    <Button Margin="0,0,0,10"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Common.LoadExample}"
                            Click="LoadActiveExampleButton_Click" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,6,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Common.LoadScript}"
                                Click="LoadActiveScriptButton_Click" />
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="{DynamicResource Common.SaveScript}"
                                Click="SaveActiveScriptButton_Click" />
                    </Grid>
                    <ContentControl ContentTemplate="{DynamicResource ViewerRecoveryActionsTemplate}" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ViewerRecoveryActionsTemplate">
                <Border Margin="0,2,0,10"
                        Padding="10"
                        Background="{StaticResource ErrorSurfaceBrush}"
                        BorderBrush="{StaticResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed"
                        Loaded="SessionRecoveryPanel_Loaded">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8"
                                   Foreground="{StaticResource ErrorTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Viewer.SimulationFaulted}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Margin="0,0,6,0"
                                    Content="HOME"
                                    ToolTip="Home the robot from the preserved faulted context."
                                    Click="SessionHomeButton_Click" />
                            <Button Grid.Column="1"
                                    Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{DynamicResource Viewer.ResetFault}"
                                    ToolTip="Acknowledge the fault without changing pose or elapsed time."
                                    Click="SessionResetFaultButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ViewerPlaybackActionsTemplate">
                <StackPanel Orientation="Horizontal">
                    <Button Width="96"
                            Height="34"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Common.Play}"
                            Loaded="PlayPauseButton_Loaded"
                            Click="PlayPauseButton_Click" />
                    <Button Width="80"
                            Height="34"
                            Margin="8,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="{DynamicResource Common.Reset}"
                            Click="ResetActivePlaybackButton_Click" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid x:Name="RobotSelectionView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,22,24,18"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left">
                        <TextBlock Text="RobotStudio"
                                   Style="{StaticResource CatalogPageTitleTextStyle}" />
                        <TextBlock MaxWidth="780"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontSize="14"
                                   Text="{DynamicResource Catalog.Introduction}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="24,3,0,0"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                        <ComboBox x:Name="LanguageComboBox"
                                  Width="156"
                                  VerticalContentAlignment="Center"
                                  ToolTip="{DynamicResource Catalog.Language.ToolTip}"
                                  SelectionChanged="LanguageComboBox_SelectionChanged" />
                        <Button Width="88"
                                Margin="8,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Content="{DynamicResource Common.Glossary}"
                                ToolTip="Open the robotics glossary (Ctrl+G)."
                                Click="OpenGlossaryButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="RobotCardsScrollViewer"
                          Grid.Row="1"
                          Margin="24,22,24,24"
                          Background="{StaticResource AppBackgroundBrush}"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="RobotCardsScrollViewer_SizeChanged">
                <UniformGrid x:Name="RobotCardsPanel"
                             Columns="3"
                             FocusVisualStyle="{x:Null}" />
            </ScrollViewer>
        </Grid>

        <ContentControl x:Name="MechanicalShowcaseHost"
                        Visibility="Collapsed" />

        <Grid x:Name="CartesianViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <viewers:ViewerHeader x:Name="CartesianViewerHeader"
                                  Grid.Row="0"
                                  Title="Cartesian Robot"
                                  Subtitle="Cartesian robot simulation">
                <viewers:ViewerHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ViewerNavigationButtonStyle}"
                                Click="BackToSelectionButton_Click"
                                Content="{DynamicResource Common.Robots}" />
                        <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                    </StackPanel>
                </viewers:ViewerHeader.Actions>
            </viewers:ViewerHeader>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="540" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RobotViewportHost"
                        Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}"
                        Cursor="Hand"
                        MouseLeftButtonDown="RobotViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="RobotViewport_MouseLeftButtonUp"
                        MouseMove="RobotViewport_MouseMove"
                        MouseWheel="RobotViewport_MouseWheel">
                    <Viewport3D x:Name="RobotViewport"
                                ClipToBounds="True"
                                IsHitTestVisible="False" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ViewerSplitterStyle}" />

                <Border Grid.Column="2"
                        Padding="0"
                        Style="{StaticResource ViewerSidebarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource SubtleBorderBrush}"
                                BorderThickness="1,0,0,0">
                            <StackPanel>
                                <RadioButton x:Name="ScriptSidebarAreaButton"
                                             GroupName="CartesianSidebarArea"
                                             IsChecked="True"
                                             Style="{StaticResource SidebarRailButtonStyle}"
                                             Tag="Script"
                                             ToolTip="{DynamicResource Sidebar.Script}"
                                             AutomationProperties.Name="{DynamicResource Sidebar.Script}"
                                             Checked="SidebarAreaButton_Checked">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE943;" />
                                </RadioButton>
                                <RadioButton x:Name="ControlSidebarAreaButton"
                                             GroupName="CartesianSidebarArea"
                                             Style="{StaticResource SidebarRailButtonStyle}"
                                             Tag="Control"
                                             ToolTip="{DynamicResource Sidebar.Control}"
                                             AutomationProperties.Name="{DynamicResource Sidebar.Control}"
                                             Checked="SidebarAreaButton_Checked">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE713;" />
                                </RadioButton>
                                <RadioButton x:Name="MonitorSidebarAreaButton"
                                             GroupName="CartesianSidebarArea"
                                             Style="{StaticResource SidebarRailButtonStyle}"
                                             Tag="Monitor"
                                             ToolTip="{DynamicResource Sidebar.Monitor}"
                                             AutomationProperties.Name="{DynamicResource Sidebar.Monitor}"
                                             Checked="SidebarAreaButton_Checked">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE9D2;" />
                                </RadioButton>
                                <RadioButton x:Name="ViewSidebarAreaButton"
                                             GroupName="CartesianSidebarArea"
                                             Style="{StaticResource SidebarRailButtonStyle}"
                                             Tag="View"
                                             ToolTip="{DynamicResource Sidebar.View}"
                                             AutomationProperties.Name="{DynamicResource Sidebar.View}"
                                             Checked="SidebarAreaButton_Checked">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="20" Text="&#xE890;" />
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="CartesianSidebarScrollViewer"
                                      Grid.Column="0"
                                      Padding="12"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                            <Expander x:Name="ScriptSidebarSection"
                                      Header="{DynamicResource Viewer.Script}"
                                      IsExpanded="True"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      ToolTip="Edit commands in the selected dialect. Validation runs automatically before simulation.">
                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,0,10"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button Width="32"
                                                Height="30"
                                                Margin="0,0,6,0"
                                                Padding="0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.Name="Load example"
                                                Content="&#xE82D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="15"
                                                ToolTip="{DynamicResource Common.LoadExample}"
                                                Click="LoadCartesianExampleButton_Click" />
                                        <Button Width="32"
                                                Height="30"
                                                Margin="0,0,6,0"
                                                Padding="0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.Name="Load script"
                                                Content="&#xE8E5;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="15"
                                                ToolTip="{DynamicResource Common.LoadScript}"
                                                Click="LoadCartesianScriptButton_Click" />
                                        <Button Width="32"
                                                Height="30"
                                                Padding="0"
                                                Style="{StaticResource GhostButtonStyle}"
                                                AutomationProperties.Name="Save script"
                                                Content="&#xE74E;"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="15"
                                                ToolTip="{DynamicResource Common.SaveScript}"
                                                Click="SaveCartesianScriptButton_Click" />
                                    </StackPanel>
                                    <TextBlock Text="{DynamicResource Viewer.Dialect}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="ScriptDialectComboBox"
                                              Margin="0,4,0,8"
                                              DisplayMemberPath="Name"
                                              ToolTip="Choose the command language used by the Cartesian script editor."
                                              SelectionChanged="ScriptDialectComboBox_SelectionChanged" />
                                    <TextBlock Text="{DynamicResource Viewer.Example}"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="CartesianExampleComboBox"
                                              Margin="0,4,0,8"
                                              ToolTip="Choose a local teaching example for the active Cartesian-family viewer."
                                              SelectionChanged="CartesianExampleComboBox_SelectionChanged" />
                                    <TextBlock x:Name="CartesianExampleDescriptionText"
                                               Margin="0,0,0,10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Select an example to load a starter script." />
                                    <Border Height="190"
                                    Margin="0,10,0,10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer x:Name="ScriptEditorGutterScrollViewer"
                                                  Grid.Column="0"
                                                  Padding="0,10,0,10"
                                                  Background="{StaticResource HeaderBackgroundBrush}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsHitTestVisible="False">
                                        <StackPanel x:Name="ScriptEditorGutterPanel" />
                                    </ScrollViewer>

                                    <TextBox x:Name="ScriptEditorTextBox"
                                             Grid.Column="1"
                                             Padding="10"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Foreground="{StaticResource SecondaryTextBrush}"
                                             Background="{StaticResource InputBackgroundBrush}"
                                             BorderThickness="0"
                                             CaretBrush="{StaticResource SecondaryTextBrush}"
                                             ToolTip="Script editor for the selected Simple DSL or introductory G-code dialect."
                                             ScrollViewer.ScrollChanged="ScriptEditorTextBox_ScrollChanged"
                                             TextChanged="ScriptTextBox_TextChanged" />
                                </Grid>
                            </Border>

                            <Button Margin="0,0,0,10"
                                        Content="{DynamicResource Common.Simulate}"
                                        ToolTip="Generate a deterministic playback snapshot from the current valid script."
                                        Click="SimulateScriptButton_Click" />

                            <TextBlock x:Name="ScriptStatusText"
                                       Style="{StaticResource ViewerScriptStatusStyle}"
                                       Text="Edit the script; validation runs automatically." />

                            <viewers:GCodeExplanationPanel x:Name="CartesianGCodeExplanationPanel" />

                            <ContentControl ContentTemplate="{StaticResource ViewerRecoveryActionsTemplate}" />

                                </StackPanel>
                            </Expander>

                            <Expander x:Name="CartesianProfileExpander"
                                      Header="{DynamicResource Viewer.RobotConfiguration}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Configure Cartesian axis limits, maximum velocity, and maximum acceleration.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="3,0,3,4" Text="Min" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Margin="3,0,3,4" Text="Max" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Margin="3,0,3,4" Text="Vel" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" ToolTip="Maximum velocity in millimeters per second." />
                                        <TextBlock Grid.Row="0" Grid.Column="4" Margin="3,0,3,4" Text="Accel" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" ToolTip="Maximum acceleration in millimeters per second squared." />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="{StaticResource AxisXBrush}" />
                                        <TextBox x:Name="ProfileXMinimumTextBox" Grid.Row="1" Grid.Column="1" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="X-axis minimum position in millimeters." />
                                        <TextBox x:Name="ProfileXMaximumTextBox" Grid.Row="1" Grid.Column="2" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="X-axis maximum position in millimeters." />
                                        <TextBox x:Name="ProfileXVelocityTextBox" Grid.Row="1" Grid.Column="3" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="X-axis maximum velocity in millimeters per second." />
                                        <TextBox x:Name="ProfileXAccelerationTextBox" Grid.Row="1" Grid.Column="4" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="X-axis maximum acceleration in millimeters per second squared." />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="{StaticResource AxisYBrush}" />
                                        <TextBox x:Name="ProfileYMinimumTextBox" Grid.Row="2" Grid.Column="1" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Y-axis minimum position in millimeters." />
                                        <TextBox x:Name="ProfileYMaximumTextBox" Grid.Row="2" Grid.Column="2" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Y-axis maximum position in millimeters." />
                                        <TextBox x:Name="ProfileYVelocityTextBox" Grid.Row="2" Grid.Column="3" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Y-axis maximum velocity in millimeters per second." />
                                        <TextBox x:Name="ProfileYAccelerationTextBox" Grid.Row="2" Grid.Column="4" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Y-axis maximum acceleration in millimeters per second squared." />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="{StaticResource AxisZBrush}" />
                                        <TextBox x:Name="ProfileZMinimumTextBox" Grid.Row="3" Grid.Column="1" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Z-axis minimum position in millimeters." />
                                        <TextBox x:Name="ProfileZMaximumTextBox" Grid.Row="3" Grid.Column="2" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Z-axis maximum position in millimeters." />
                                        <TextBox x:Name="ProfileZVelocityTextBox" Grid.Row="3" Grid.Column="3" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Z-axis maximum velocity in millimeters per second." />
                                        <TextBox x:Name="ProfileZAccelerationTextBox" Grid.Row="3" Grid.Column="4" Margin="3" Padding="5,3" TextAlignment="Right" ToolTip="Z-axis maximum acceleration in millimeters per second squared." />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Margin="0,0,6,0"
                                                Content="Apply"
                                                ToolTip="Validate the profile and regenerate playback with the new physical limits."
                                                Click="ApplyCartesianProfileButton_Click" />
                                        <Button Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Content="Restore"
                                                ToolTip="Restore the default Cartesian robot profile."
                                                Click="RestoreCartesianProfileButton_Click" />
                                    </Grid>

                                    <TextBlock x:Name="CartesianProfileStatusText"
                                               Margin="0,10,0,8"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Text="Default Cartesian profile." />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ControlManualSection"
                                      Header="{DynamicResource Viewer.ManualControl}"
                                      IsExpanded="True"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Jog the simulated Cartesian robot by appending commands in the selected dialect.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Step mm" />
                                <TextBox x:Name="ManualStepTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,4,6,0"
                                         Padding="8,4"
                                         Text="10"
                                         ToolTip="Distance applied by each jog command, in millimeters."
                                         Foreground="{StaticResource SecondaryTextBrush}"
                                         Background="{StaticResource InputBackgroundBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         CaretBrush="{StaticResource SecondaryTextBrush}" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Speed mm/s" />
                                <TextBox x:Name="ManualSpeedTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="30"
                                         Margin="6,4,0,0"
                                         Padding="8,4"
                                         Text="80"
                                         ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                         Foreground="{StaticResource SecondaryTextBrush}"
                                         Background="{StaticResource InputBackgroundBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         CaretBrush="{StaticResource SecondaryTextBrush}" />
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Margin="0,0,6,6" Content="X-" ToolTip="Move one step in the negative X direction." Click="JogNegativeXButton_Click" />
                                <Button Margin="0,0,6,6" Content="HOME" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Homing}" Click="ManualHomeButton_Click" />
                                <Button Margin="0,0,0,6" Content="X+" ToolTip="Move one step in the positive X direction." Click="JogPositiveXButton_Click" />
                                <Button Margin="0,0,6,6" Content="Y-" ToolTip="Move one step in the negative Y direction." Click="JogNegativeYButton_Click" />
                                <Button Margin="0,0,6,6" Content="Stop" ToolTip="Stop visual playback without changing the simulated command sequence." Click="StopPlaybackButton_Click" />
                                <Button Margin="0,0,0,6" Content="Y+" ToolTip="Move one step in the positive Y direction." Click="JogPositiveYButton_Click" />
                                <Button x:Name="JogNegativeZButton" Margin="0,0,6,0" Content="Z-" ToolTip="Move one step in the negative Z direction." Click="JogNegativeZButton_Click" />
                                <Button Margin="0,0,6,0" Content="Reset" ToolTip="Return playback to the first generated frame." Click="ResetButton_Click" />
                                <Button x:Name="JogPositiveZButton" Content="Z+" ToolTip="Move one step in the positive Z direction." Click="JogPositiveZButton_Click" />
                            </UniformGrid>

                            <TextBlock x:Name="ManualControlStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Manual actions append commands in the selected dialect and resimulate the robot." />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ScriptConsoleSection"
                                      Header="{DynamicResource Viewer.CommandConsole}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      ToolTip="Execute one command in the selected dialect and append valid commands to the script.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CommandConsoleTextBox"
                                         Grid.Column="0"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         Padding="8,5"
                                         FontFamily="Consolas"
                                         Text="MOVE X=100 Y=50 Z=20 SPEED=80"
                                         ToolTip="Type one command in the selected dialect. Press Enter or Execute to validate and append it."
                                         Foreground="{StaticResource SecondaryTextBrush}"
                                         Background="{StaticResource InputBackgroundBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         CaretBrush="{StaticResource SecondaryTextBrush}"
                                         KeyDown="CommandConsoleTextBox_KeyDown" />
                                <Button Grid.Column="1"
                                        Content="Execute"
                                        ToolTip="Validate and execute the command currently typed in the console."
                                        Click="ExecuteCommandButton_Click" />
                            </Grid>

                            <ListBox x:Name="CommandHistoryListBox"
                                     Height="92"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     Background="{StaticResource InputBackgroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="CommandConsoleStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="Execute one command in the selected dialect at a time." />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="MonitorStateSection"
                                      Header="{DynamicResource Viewer.RobotState}"
                                      IsExpanded="True"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="{x:Static didactics:DidacticTooltipCatalog.RobotState}">
                                <Grid Margin="0,12,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.State}" />
                                <TextBlock x:Name="StateValueText" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.Position}" />
                                <TextBlock x:Name="PositionValueText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.Command}" />
                                <TextBlock x:Name="CommandValueText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.Source}" />
                                <TextBlock x:Name="SourceValueText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.Time}" />
                                <TextBlock x:Name="TimeValueText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource Viewer.Frames}" />
                                <TextBlock x:Name="FramesValueText" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Profile phase" ToolTip="{x:Static didactics:DidacticTooltipCatalog.MotionProfile}" />
                                <TextBlock x:Name="ProfilePhaseValueText" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.MotionProfile}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Velocity" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />
                                <TextBlock x:Name="VelocityValueText" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" Text="Acceleration" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />
                                <TextBlock x:Name="AccelerationValueText" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />
                            </Grid>
                            </Expander>

                            <Expander x:Name="MonitorChartsSection"
                                      Header="{DynamicResource Viewer.Charts}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Inspect position, velocity, state, and distance values derived from playback frames.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Position Chart"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <Border Height="156"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="PositionChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="PositionChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <TextBlock Foreground="{StaticResource AxisXBrush}" Text="X axis" />
                                <TextBlock Foreground="{StaticResource AxisYBrush}" Text="Y axis" />
                                <TextBlock Foreground="{StaticResource AxisZBrush}" Text="Z axis" />
                            </UniformGrid>

                                    <TextBlock Text="Velocity Chart"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="VelocityChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Exact effective velocity in mm/s from the planned motion profile."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="Requested vs Effective"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="VelocityComparisonChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityComparisonChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <TextBlock Foreground="{StaticResource RequestedSeriesBrush}" Text="Requested" ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}" />
                                <TextBlock Foreground="{StaticResource EffectiveSeriesBrush}" Text="Effective" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />
                            </UniformGrid>

                                    <TextBlock Text="Acceleration Chart"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="AccelerationChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="AccelerationChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <TextBlock Foreground="{StaticResource PositiveSeriesBrush}" Text="Acceleration" />
                                <TextBlock Foreground="{StaticResource NegativeSeriesBrush}" Text="Deceleration" />
                            </UniformGrid>

                                    <TextBlock Text="Distance Chart"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="DistanceChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="DistanceChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Accumulated TCP distance in millimeters."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.ToolCenterPoint}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="State Chart"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="168"
                                    Margin="0,10,0,20"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Canvas x:Name="StateChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="StateChartCanvas_SizeChanged" />
                            </Border>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="MonitorExplanationSection"
                                      Header="{DynamicResource Viewer.MovementExplanation}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Read a didactic explanation of the current command and movement constraints.">
                                <TextBlock x:Name="MovementExplanationText"
                                       Margin="0,10,0,20"
                                       Padding="10"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Background="{StaticResource InputBackgroundBrush}"
                                       TextWrapping="Wrap"
                                       Text="Open a robot simulation to inspect command explanations." />
                            </Expander>

                            <Expander x:Name="MonitorTimelineSection"
                                      Header="{DynamicResource Viewer.TimelineMarkers}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="{x:Static didactics:DidacticTooltipCatalog.Timeline}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,10,0,4"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="Commands" />
                            <ListBox x:Name="CommandMarkersListBox"
                                     Height="96"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     Background="{StaticResource InputBackgroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     SelectionChanged="TimelineMarkerListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Margin="0,0,0,4"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="States" />
                            <ListBox x:Name="StateMarkersListBox"
                                     Height="96"
                                     Margin="0,0,0,20"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="{StaticResource SecondaryTextBrush}"
                                     Background="{StaticResource InputBackgroundBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     SelectionChanged="TimelineMarkerListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="ViewOverlaysSection"
                                      Header="{DynamicResource Viewer.Overlays}"
                                      IsExpanded="False"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Show or hide educational 3D overlays without regenerating the simulation.">
                                <UniformGrid Columns="2"
                                             Margin="0,10,0,20"
                                             TextElement.FontSize="13">
                                <CheckBox x:Name="ShowGridCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show the workspace reference grid."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Grid" />
                                <CheckBox x:Name="ShowGlobalAxesCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show the global X, Y, and Z coordinate axes."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Global axes" />
                                <CheckBox x:Name="ShowAxisLabelsCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show labels near the global X, Y, and Z axes."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="X/Y/Z labels" />
                                <CheckBox x:Name="ShowWorkspaceCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.Workspace}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Workspace" />
                                <CheckBox x:Name="ShowRailsCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show fixed Cartesian rails."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Rails" />
                                <CheckBox x:Name="ShowPlannedPathCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.PlannedPath}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Path" />
                                <CheckBox x:Name="ShowStartEndMarkersCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show markers for the first and final TCP positions."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Start / end" />
                                <CheckBox x:Name="ShowCarriagesCheckBox"
                                          Margin="0,0,8,0"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="Show moving carriage components."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Carriages" />
                                <CheckBox x:Name="ShowToolCheckBox"
                                          Margin="0,0,0,0"
                                          Foreground="{StaticResource SecondaryTextBrush}"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.ToolCenterPoint}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="TCP / tool" />
                            </UniformGrid>
                            </Expander>

                            <Expander x:Name="ViewCameraSection"
                                      Header="{DynamicResource Viewer.Camera}"
                                      IsExpanded="True"
                                      Style="{StaticResource FlatSidebarSectionStyle}"
                                      Visibility="Collapsed"
                                      ToolTip="Control only the desktop camera. This does not change robot simulation data.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,12,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Azimuth" />
                                    <Slider x:Name="AzimuthSlider"
                                            Minimum="-180"
                                            Maximum="180"
                                            ToolTip="Rotate the camera horizontally around the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <TextBlock Margin="0,12,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Elevation" />
                                    <Slider x:Name="ElevationSlider"
                                            Minimum="10"
                                            Maximum="80"
                                            ToolTip="Raise or lower the camera angle around the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <TextBlock Margin="0,12,0,4" Foreground="{StaticResource MutedTextBrush}" Text="Zoom" />
                                    <Slider x:Name="ZoomSlider"
                                            Minimum="0.6"
                                            Maximum="2.4"
                                            ToolTip="Move the camera closer to or farther from the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,6,8"
                                                Content="Iso"
                                                ToolTip="Use an isometric didactic camera view."
                                                Click="IsoViewButton_Click" />
                                        <Button Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="6,0,0,8"
                                                Content="Front"
                                                ToolTip="View the robot from the front."
                                                Click="FrontViewButton_Click" />
                                        <Button Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,6,8"
                                                Content="Side"
                                                ToolTip="View the robot from the side."
                                                Click="SideViewButton_Click" />
                                        <Button Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="6,0,0,8"
                                                Content="Top"
                                                ToolTip="View the robot from above."
                                                Click="TopViewButton_Click" />
                                        <Button Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Content="Reset Camera"
                                                ToolTip="Return the camera to the default isometric view."
                                                Click="ResetCameraButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="16,0,16,16"
                    Style="{DynamicResource ViewerTimelineSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="34"
                            Height="34"
                            Margin="0,0,8,0"
                            Padding="0"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            ToolTip="Move one playback frame backward."
                            AutomationProperties.Name="Previous frame"
                            Click="PreviousFrameButton_Click" />
                    <Button Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Padding="0"
                            Style="{StaticResource GhostButtonStyle}"
                            Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            ToolTip="Move one playback frame forward."
                            AutomationProperties.Name="Next frame"
                            Click="NextFrameButton_Click" />
                    <ComboBox x:Name="PlaybackSpeedComboBox"
                              Width="88"
                              ToolTip="{x:Static didactics:DidacticTooltipCatalog.Playback}"
                              AutomationProperties.Name="Playback speed"
                              SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="4x" Tag="4" />
                    </ComboBox>
                </StackPanel>

                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Minimum="0"
                        IsSnapToTickEnabled="True"
                        Style="{DynamicResource TimelineSliderStyle}"
                        ToolTip="{x:Static didactics:DidacticTooltipCatalog.Timeline}"
                        ValueChanged="TimelineSlider_ValueChanged" />

                <StackPanel Grid.Column="2"
                            Margin="16,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <viewers:PlaybackStateBadge x:Name="CartesianTimelineStateBadge"
                                                Margin="0,0,12,0" />
                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               TextAlignment="Right" />
                </StackPanel>
            </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DifferentialDriveViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <viewers:ViewerHeader Grid.Row="0"
                                  Title="Differential Drive Robot"
                                  Subtitle="Differential drive robot simulation">
                <viewers:ViewerHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ViewerNavigationButtonStyle}"
                                Click="BackToSelectionButton_Click"
                                Content="{DynamicResource Common.Robots}" />
                        <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                    </StackPanel>
                </viewers:ViewerHeader.Actions>
            </viewers:ViewerHeader>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}">
                    <Canvas x:Name="DifferentialDriveCanvas"
                            ClipToBounds="True"
                            MouseWheel="DifferentialDriveCanvas_MouseWheel"
                            SizeChanged="DifferentialDriveCanvas_SizeChanged" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ViewerSplitterStyle}" />

                <Border Grid.Column="2"
                        Style="{StaticResource ViewerSidebarStyle}">
                    <StackPanel>
                        <TextBlock Text="Robot State"
                                   Style="{StaticResource ViewerSectionHeadingStyle}" />

                        <Grid Style="{StaticResource ViewerStateGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ViewerStateLabelStyle}" Text="State" />
                            <TextBlock x:Name="DifferentialDriveStateText" Grid.Row="0" Grid.Column="1" Style="{StaticResource ViewerStateValueStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource ViewerStateLabelStyle}" Text="Pose" />
                            <TextBlock x:Name="DifferentialDrivePoseText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource ViewerStateValueStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource ViewerStateLabelStyle}" Text="Command" />
                            <TextBlock x:Name="DifferentialDriveCommandText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource ViewerStateValueStyle}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource ViewerStateLabelStyle}" Text="Time" />
                            <TextBlock x:Name="DifferentialDriveTimeText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource ViewerStateValueStyle}" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Style="{StaticResource ViewerStateLabelStyle}" Text="Frames" />
                            <TextBlock x:Name="DifferentialDriveFramesText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Style="{StaticResource ViewerStateValueStyle}" />
                        </Grid>

                        <Border Style="{StaticResource ViewerSectionDividerStyle}" />
                        <TextBlock Text="Script"
                                   Style="{StaticResource ViewerSectionHeadingStyle}" />
                        <TextBlock Text="Example"
                                   Style="{StaticResource ViewerScriptFieldLabelStyle}" />
                        <ComboBox x:Name="DifferentialDriveExampleComboBox"
                                  Margin="0,0,0,8" />
                        <TextBox x:Name="DifferentialDriveScriptTextBox"
                                 Style="{StaticResource ViewerScriptEditorStyle}"
                                 TextChanged="ScriptTextBox_TextChanged" />

                        <ContentControl ContentTemplate="{StaticResource ViewerScriptActionsTemplate}" />

                        <TextBlock x:Name="DifferentialDriveScriptStatusText"
                                   Style="{StaticResource ViewerScriptStatusStyle}"
                                   Text="Edit the script; validation runs automatically." />
                    </StackPanel>
                </Border>
            </Grid>

            <viewers:ViewerTimeline x:Name="DifferentialDriveTimeline"
                                    Grid.Row="2"
                                    Margin="16,0,16,16"
                                    PreviousRequested="DifferentialDrivePreviousFrameButton_Click"
                                    NextRequested="DifferentialDriveNextFrameButton_Click"
                                    PlaybackSpeedChanged="ViewerPlaybackSpeed_SelectionChanged"
                                    ValueChanged="DifferentialDriveTimelineSlider_ValueChanged" />
        </Grid>

        <Grid x:Name="ScaraViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <viewers:ViewerHeader Grid.Row="0"
                                  Title="SCARA Robot"
                                  Subtitle="SCARA robot simulation">
                <viewers:ViewerHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ViewerNavigationButtonStyle}" Click="BackToSelectionButton_Click" Content="{DynamicResource Common.Robots}" />
                        <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                    </StackPanel>
                </viewers:ViewerHeader.Actions>
            </viewers:ViewerHeader>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScaraViewportHost"
                        Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}"
                        Cursor="Hand"
                        MouseLeftButtonDown="ScaraViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="ScaraViewport_MouseLeftButtonUp"
                        MouseMove="ScaraViewport_MouseMove"
                        MouseWheel="ScaraViewport_MouseWheel">
                    <Viewport3D x:Name="ScaraViewport"
                                ClipToBounds="True"
                                SizeChanged="ScaraViewport_SizeChanged"
                                IsHitTestVisible="False" />
                </Border>

