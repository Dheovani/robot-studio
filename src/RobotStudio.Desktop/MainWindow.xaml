<Window x:Class="RobotStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:didactics="clr-namespace:RobotStudio.Desktop.Didactics"
        xmlns:viewers="clr-namespace:RobotStudio.Desktop.Viewers"
        Title="RobotStudio"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Icon="Assets/RobotStudio.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseWheel="MainWindow_PreviewMouseWheel">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="SubtlePanelBackgroundBrush" Color="#122033" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#60A5FA" />
        <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />
        <Thickness x:Key="PanelSectionSpacing">0,0,0,10</Thickness>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource ButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonPressedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SubtleBorderBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SubtlePanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style x:Key="ViewerHeaderStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="16,12,16,10" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>

        <Style x:Key="ViewerTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ViewerSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ViewerToolbarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <Style x:Key="ViewerViewportStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="ViewerSidebarStyle" TargetType="Border">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource HeaderBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="ViewerSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
        </Style>

        <Style x:Key="ViewerSectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ViewerHelpTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ViewerSectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,16,0,16" />
            <Setter Property="Background" Value="{StaticResource SubtleBorderBrush}" />
        </Style>

        <Style x:Key="ViewerScriptEditorStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="142" />
            <Setter Property="Margin" Value="0,10,0,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="{StaticResource PanelSectionSpacing}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="ViewerScriptActionsTemplate">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Validate"
                            Click="ValidateActiveScriptButton_Click" />
                    <Button Grid.Column="1"
                            Margin="6,0,0,0"
                            Content="Simulate"
                            Click="SimulateActiveScriptButton_Click" />
                </Grid>
                <Button Margin="0,0,0,10"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Load Example"
                        Click="LoadActiveExampleButton_Click" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Load Script"
                            Click="LoadActiveScriptButton_Click" />
                    <Button Grid.Column="1"
                            Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Save Script"
                            Click="SaveActiveScriptButton_Click" />
                </Grid>
                <ContentControl ContentTemplate="{DynamicResource ViewerRecoveryActionsTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ViewerRecoveryActionsTemplate">
            <Border Margin="0,2,0,10"
                    Padding="10"
                    Background="#261F2937"
                    BorderBrush="#7F1D1D"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Loaded="SessionRecoveryPanel_Loaded">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Foreground="#FCA5A5"
                               FontWeight="SemiBold"
                               Text="Simulation faulted" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Margin="0,0,6,0"
                                Content="HOME"
                                ToolTip="Home the robot from the preserved faulted context."
                                Click="SessionHomeButton_Click" />
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Reset Fault"
                                ToolTip="Acknowledge the fault without changing pose or elapsed time."
                                Click="SessionResetFaultButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ViewerPlaybackActionsTemplate">
            <StackPanel Orientation="Horizontal">
                <Button Width="96"
                        Height="34"
                        Margin="8,0,0,0"
                        Content="Play"
                        Loaded="PlayPauseButton_Loaded"
                        Click="PlayPauseButton_Click" />
                <Button Width="80"
                        Height="34"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="Reset"
                        Click="ResetActivePlaybackButton_Click" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="RobotSelectionView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,22,24,18"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left">
                        <TextBlock Text="RobotStudio"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock MaxWidth="780"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Text="Choose a robot model to inspect, simulate, and control. Available models open directly; planned models show the future learning path." />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Height="34"
                            Margin="24,3,0,0"
                            Padding="12,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource SubtlePanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#93C5FD"
                                   FontWeight="SemiBold"
                                   Text="Robot Catalog" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="RobotCardsScrollViewer"
                          Grid.Row="1"
                          Margin="24,22,24,24"
                          Background="{StaticResource AppBackgroundBrush}"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="RobotCardsScrollViewer_SizeChanged">
                <UniformGrid x:Name="RobotCardsPanel"
                             Columns="3"
                             FocusVisualStyle="{x:Null}" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CartesianViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Style="{StaticResource ViewerHeaderStyle}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Cartesian Robot"
                               Style="{StaticResource ViewerTitleStyle}" />
                    <TextBlock x:Name="ViewerSubtitleText"
                               Text="Cartesian robot simulation"
                               Style="{StaticResource ViewerSubtitleStyle}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ViewerToolbarButtonStyle}"
                            Click="BackToSelectionButton_Click"
                            Content="Robots" />
                    <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="540" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RobotViewportHost"
                        Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}"
                        Cursor="Hand"
                        MouseLeftButtonDown="RobotViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="RobotViewport_MouseLeftButtonUp"
                        MouseMove="RobotViewport_MouseMove"
                        MouseWheel="RobotViewport_MouseWheel">
                    <Viewport3D x:Name="RobotViewport"
                                ClipToBounds="True"
                                IsHitTestVisible="False" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ViewerSplitterStyle}" />

                <Border Grid.Column="2"
                        Style="{StaticResource ViewerSidebarStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Expander Header="Script"
                                      IsExpanded="True"
                                      ToolTip="Edit DSL commands before validating or simulating the robot.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Example"
                                               Foreground="#94A3B8" />
                                    <ComboBox x:Name="CartesianExampleComboBox"
                                              Margin="0,4,0,8"
                                              ToolTip="Choose a local teaching example for the active Cartesian-family viewer."
                                              SelectionChanged="CartesianExampleComboBox_SelectionChanged" />
                                    <TextBlock x:Name="CartesianExampleDescriptionText"
                                               Margin="0,0,0,10"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               Text="Select an example to load a starter script." />
                                    <Button Margin="0,0,0,10"
                                            Content="Load Example"
                                            ToolTip="Load the selected example into the script editor and regenerate playback."
                                            Click="LoadCartesianExampleButton_Click" />

                                    <Border Height="190"
                                    Margin="0,10,0,10"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer x:Name="ScriptEditorGutterScrollViewer"
                                                  Grid.Column="0"
                                                  Padding="0,10,0,10"
                                                  Background="#0B1220"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsHitTestVisible="False">
                                        <StackPanel x:Name="ScriptEditorGutterPanel" />
                                    </ScrollViewer>

                                    <TextBox x:Name="ScriptEditorTextBox"
                                             Grid.Column="1"
                                             Padding="10"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Foreground="#E5E7EB"
                                             Background="#111827"
                                             BorderThickness="0"
                                             CaretBrush="#E5E7EB"
                                             ToolTip="DSL script editor. Supported commands are HOME, MOVE, and WAIT."
                                             ScrollViewer.ScrollChanged="ScriptEditorTextBox_ScrollChanged"
                                             TextChanged="ScriptEditorTextBox_TextChanged" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Content="Validate"
                                        ToolTip="Parse the DSL script and check Cartesian limits without changing playback."
                                        Click="ValidateScriptButton_Click" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Content="Simulate"
                                        ToolTip="Generate a deterministic playback snapshot from the current valid script."
                                        Click="SimulateScriptButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Content="Load Script"
                                        ToolTip="Load a DSL script from a local text file."
                                        Click="LoadCartesianScriptButton_Click" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Content="Save Script"
                                        ToolTip="Save the current DSL script to a local text file."
                                        Click="SaveCartesianScriptButton_Click" />
                            </Grid>

                            <TextBlock x:Name="ScriptStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Edit the DSL script and validate it before simulation." />

                            <ContentControl ContentTemplate="{StaticResource ViewerRecoveryActionsTemplate}" />

                            <TextBlock x:Name="CurrentScriptLineText"
                                       Margin="0,0,0,18"
                                       Foreground="#93C5FD"
                                       TextWrapping="Wrap"
                                       Text="Current script line: -" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Manual Control"
                                      IsExpanded="True"
                                      ToolTip="Jog the simulated Cartesian robot by appending DSL commands.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Foreground="#94A3B8"
                                           Text="Step mm" />
                                <TextBox x:Name="ManualStepTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,4,6,0"
                                         Padding="8,4"
                                         Text="10"
                                         ToolTip="Distance applied by each jog command, in millimeters."
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Foreground="#94A3B8"
                                           Text="Speed mm/s" />
                                <TextBox x:Name="ManualSpeedTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="30"
                                         Margin="6,4,0,0"
                                         Padding="8,4"
                                         Text="80"
                                         ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Margin="0,0,6,6" Content="X-" ToolTip="Move one step in the negative X direction." Click="JogNegativeXButton_Click" />
                                <Button Margin="0,0,6,6" Content="HOME" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Homing}" Click="ManualHomeButton_Click" />
                                <Button Margin="0,0,0,6" Content="X+" ToolTip="Move one step in the positive X direction." Click="JogPositiveXButton_Click" />
                                <Button Margin="0,0,6,6" Content="Y-" ToolTip="Move one step in the negative Y direction." Click="JogNegativeYButton_Click" />
                                <Button Margin="0,0,6,6" Content="Stop" ToolTip="Stop visual playback without changing the simulated command sequence." Click="StopPlaybackButton_Click" />
                                <Button Margin="0,0,0,6" Content="Y+" ToolTip="Move one step in the positive Y direction." Click="JogPositiveYButton_Click" />
                                <Button x:Name="JogNegativeZButton" Margin="0,0,6,0" Content="Z-" ToolTip="Move one step in the negative Z direction." Click="JogNegativeZButton_Click" />
                                <Button Margin="0,0,6,0" Content="Reset" ToolTip="Return playback to the first generated frame." Click="ResetButton_Click" />
                                <Button x:Name="JogPositiveZButton" Content="Z+" ToolTip="Move one step in the positive Z direction." Click="JogPositiveZButton_Click" />
                            </UniformGrid>

                            <TextBlock x:Name="ManualControlStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Manual actions append DSL commands and resimulate the robot." />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Command Console"
                                      IsExpanded="False"
                                      ToolTip="Execute one DSL command at a time and append valid commands to the script.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CommandConsoleTextBox"
                                         Grid.Column="0"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         Padding="8,5"
                                         FontFamily="Consolas"
                                         Text="MOVE X=100 Y=50 Z=20 SPEED=80"
                                         ToolTip="Type one DSL command. Press Enter or Execute to validate and append it."
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB"
                                         KeyDown="CommandConsoleTextBox_KeyDown" />
                                <Button Grid.Column="1"
                                        Content="Execute"
                                        ToolTip="Validate and execute the command currently typed in the console."
                                        Click="ExecuteCommandButton_Click" />
                            </Grid>

                            <ListBox x:Name="CommandHistoryListBox"
                                     Height="92"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#CBD5E1"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="CommandConsoleStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Execute one DSL command at a time." />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Robot State"
                                      IsExpanded="True"
                                      ToolTip="{x:Static didactics:DidacticTooltipCatalog.RobotState}">
                                <Grid Margin="0,12,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#94A3B8" Text="State" />
                                <TextBlock x:Name="StateValueText" Grid.Row="0" Grid.Column="1" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Position" />
                                <TextBlock x:Name="PositionValueText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Command" />
                                <TextBlock x:Name="CommandValueText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Source" />
                                <TextBlock x:Name="SourceValueText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Time" />
                                <TextBlock x:Name="TimeValueText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Frames" />
                                <TextBlock x:Name="FramesValueText" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Profile phase" ToolTip="{x:Static didactics:DidacticTooltipCatalog.MotionProfile}" />
                                <TextBlock x:Name="ProfilePhaseValueText" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.MotionProfile}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Velocity" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />
                                <TextBlock x:Name="VelocityValueText" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Acceleration" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />
                                <TextBlock x:Name="AccelerationValueText" Grid.Row="8" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />
                            </Grid>
                            </Expander>

                            <Expander Header="Charts"
                                      IsExpanded="False"
                                      ToolTip="Inspect position, velocity, state, and distance values derived from playback frames.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Position Chart"
                                               Foreground="#F9FAFB"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <Border Height="156"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="PositionChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="PositionChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <TextBlock Foreground="#F87171" Text="X axis" />
                                <TextBlock Foreground="#22C55E" Text="Y axis" />
                                <TextBlock Foreground="#60A5FA" Text="Z axis" />
                            </UniformGrid>

                                    <TextBlock Text="Velocity Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="VelocityChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="#94A3B8"
                                       Text="Exact effective velocity in mm/s from the planned motion profile."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="Requested vs Effective"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="VelocityComparisonChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityComparisonChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <TextBlock Foreground="#38BDF8" Text="Requested" ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}" />
                                <TextBlock Foreground="#FACC15" Text="Effective" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />
                            </UniformGrid>

                                    <TextBlock Text="Acceleration Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.Acceleration}" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="AccelerationChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="AccelerationChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <TextBlock Foreground="#22C55E" Text="Acceleration" />
                                <TextBlock Foreground="#F87171" Text="Deceleration" />
                            </UniformGrid>

                                    <TextBlock Text="Distance Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="DistanceChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="DistanceChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="#94A3B8"
                                       Text="Accumulated TCP distance in millimeters."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.ToolCenterPoint}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="State Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="168"
                                    Margin="0,10,0,20"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="StateChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="StateChartCanvas_SizeChanged" />
                            </Border>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Movement Explanation"
                                      IsExpanded="False"
                                      ToolTip="Read a didactic explanation of the current command and movement constraints.">
                                <TextBlock x:Name="MovementExplanationText"
                                       Margin="0,10,0,20"
                                       Padding="10"
                                       Foreground="#CBD5E1"
                                       Background="#111827"
                                       TextWrapping="Wrap"
                                       Text="Open a robot simulation to inspect command explanations." />
                            </Expander>

                            <Expander Header="Timeline Markers"
                                      IsExpanded="False"
                                      ToolTip="{x:Static didactics:DidacticTooltipCatalog.Timeline}">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,10,0,4"
                                       Foreground="#94A3B8"
                                       Text="Commands" />
                            <ListBox x:Name="CommandMarkersListBox"
                                     Height="96"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#CBD5E1"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     SelectionChanged="TimelineMarkerListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                            <TextBlock Margin="0,0,0,4"
                                       Foreground="#94A3B8"
                                       Text="States" />
                            <ListBox x:Name="StateMarkersListBox"
                                     Height="96"
                                     Margin="0,0,0,20"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#CBD5E1"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     SelectionChanged="TimelineMarkerListBox_SelectionChanged"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Overlays"
                                      IsExpanded="False"
                                      ToolTip="Show or hide educational 3D overlays without regenerating the simulation.">
                                <UniformGrid Columns="2" Margin="0,10,0,20">
                                <CheckBox x:Name="ShowGridCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show the workspace reference grid."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Grid" />
                                <CheckBox x:Name="ShowGlobalAxesCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show the global X, Y, and Z coordinate axes."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Global axes" />
                                <CheckBox x:Name="ShowAxisLabelsCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show labels near the global X, Y, and Z axes."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="X/Y/Z labels" />
                                <CheckBox x:Name="ShowWorkspaceCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.Workspace}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Workspace" />
                                <CheckBox x:Name="ShowRailsCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show fixed Cartesian rails."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Rails" />
                                <CheckBox x:Name="ShowPlannedPathCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.PlannedPath}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Path" />
                                <CheckBox x:Name="ShowStartEndMarkersCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show markers for the first and final TCP positions."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Start / end" />
                                <CheckBox x:Name="ShowCarriagesCheckBox"
                                          Margin="0,0,8,0"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="Show moving carriage components."
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Carriages" />
                                <CheckBox x:Name="ShowToolCheckBox"
                                          Margin="0,0,0,0"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          ToolTip="{x:Static didactics:DidacticTooltipCatalog.ToolCenterPoint}"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="TCP / tool" />
                            </UniformGrid>
                            </Expander>

                            <Expander Header="Camera"
                                      IsExpanded="True"
                                      ToolTip="Control only the desktop camera. This does not change robot simulation data.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Azimuth" />
                                    <Slider x:Name="AzimuthSlider"
                                            Minimum="-180"
                                            Maximum="180"
                                            ToolTip="Rotate the camera horizontally around the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Elevation" />
                                    <Slider x:Name="ElevationSlider"
                                            Minimum="10"
                                            Maximum="80"
                                            ToolTip="Raise or lower the camera angle around the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Zoom" />
                                    <Slider x:Name="ZoomSlider"
                                            Minimum="0.6"
                                            Maximum="2.4"
                                            ToolTip="Move the camera closer to or farther from the robot."
                                            ValueChanged="CameraSlider_ValueChanged" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Button Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="0,0,6,8"
                                                Content="Iso"
                                                ToolTip="Use an isometric didactic camera view."
                                                Click="IsoViewButton_Click" />
                                        <Button Grid.Row="0"
                                                Grid.Column="1"
                                                Margin="6,0,0,8"
                                                Content="Front"
                                                ToolTip="View the robot from the front."
                                                Click="FrontViewButton_Click" />
                                        <Button Grid.Row="1"
                                                Grid.Column="0"
                                                Margin="0,0,6,8"
                                                Content="Side"
                                                ToolTip="View the robot from the side."
                                                Click="SideViewButton_Click" />
                                        <Button Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="6,0,0,8"
                                                Content="Top"
                                                ToolTip="View the robot from above."
                                                Click="TopViewButton_Click" />
                                        <Button Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Content="Reset Camera"
                                                ToolTip="Return the camera to the default isometric view."
                                                Click="ResetCameraButton_Click" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Margin="16,0,16,16"
                    Padding="10,8"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="48"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Prev"
                            ToolTip="Move one playback frame backward."
                            Click="PreviousFrameButton_Click" />
                    <Button Width="48"
                            Margin="0,0,12,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Content="Next"
                            ToolTip="Move one playback frame forward."
                            Click="NextFrameButton_Click" />
                    <ComboBox x:Name="PlaybackSpeedComboBox"
                              Width="88"
                              ToolTip="{x:Static didactics:DidacticTooltipCatalog.Playback}"
                              SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="4x" Tag="4" />
                    </ComboBox>
                </StackPanel>

                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Minimum="0"
                        IsSnapToTickEnabled="True"
                        ToolTip="{x:Static didactics:DidacticTooltipCatalog.Timeline}"
                        ValueChanged="TimelineSlider_ValueChanged" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#E5E7EB"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextAlignment="Right" />
            </Grid>
            </Border>
        </Grid>

        <Grid x:Name="DifferentialDriveViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Style="{StaticResource ViewerHeaderStyle}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Differential Drive Robot"
                               Style="{StaticResource ViewerTitleStyle}" />
                    <TextBlock Text="Differential drive robot simulation"
                               Style="{StaticResource ViewerSubtitleStyle}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ViewerToolbarButtonStyle}"
                            Click="BackToSelectionButton_Click"
                            Content="Robots" />
                    <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}">
                    <Canvas x:Name="DifferentialDriveCanvas"
                            ClipToBounds="True"
                            MouseWheel="DifferentialDriveCanvas_MouseWheel"
                            SizeChanged="DifferentialDriveCanvas_SizeChanged" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ViewerSplitterStyle}" />

                <Border Grid.Column="2"
                        Style="{StaticResource ViewerSidebarStyle}">
                    <StackPanel>
                        <TextBlock Text="Robot State"
                                   Style="{StaticResource ViewerSectionHeadingStyle}" />

                        <Grid Margin="0,18,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#94A3B8" Text="State" />
                            <TextBlock x:Name="DifferentialDriveStateText" Grid.Row="0" Grid.Column="1" Foreground="#E5E7EB" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Pose" />
                            <TextBlock x:Name="DifferentialDrivePoseText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Command" />
                            <TextBlock x:Name="DifferentialDriveCommandText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Time" />
                            <TextBlock x:Name="DifferentialDriveTimeText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Frames" />
                            <TextBlock x:Name="DifferentialDriveFramesText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource ViewerSectionDividerStyle}" />
                        <TextBlock Text="Script"
                                   Style="{StaticResource ViewerSectionHeadingStyle}" />
                        <TextBlock Text="Example"
                                   Margin="0,10,0,4"
                                   Foreground="#94A3B8" />
                        <ComboBox x:Name="DifferentialDriveExampleComboBox"
                                  Margin="0,0,0,8" />
                        <TextBox x:Name="DifferentialDriveScriptTextBox"
                                 Style="{StaticResource ViewerScriptEditorStyle}" />

                        <ContentControl ContentTemplate="{StaticResource ViewerScriptActionsTemplate}" />

                        <TextBlock x:Name="DifferentialDriveScriptStatusText"
                                   Style="{StaticResource ViewerHelpTextStyle}"
                                   Text="Edit DRIVE commands and simulate the mobile robot." />
                    </StackPanel>
                </Border>
            </Grid>

            <viewers:ViewerTimeline x:Name="DifferentialDriveTimeline"
                                    Grid.Row="2"
                                    Margin="16,0,16,16"
                                    PreviousRequested="DifferentialDrivePreviousFrameButton_Click"
                                    NextRequested="DifferentialDriveNextFrameButton_Click"
                                    ValueChanged="DifferentialDriveTimelineSlider_ValueChanged" />
        </Grid>

        <Grid x:Name="ScaraViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Style="{StaticResource ViewerHeaderStyle}">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="SCARA Robot"
                               Style="{StaticResource ViewerTitleStyle}" />
                    <TextBlock Text="SCARA robot simulation"
                               Style="{StaticResource ViewerSubtitleStyle}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource ViewerToolbarButtonStyle}" Click="BackToSelectionButton_Click" Content="Robots" />
                    <ContentControl ContentTemplate="{StaticResource ViewerPlaybackActionsTemplate}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="460" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScaraViewportHost"
                        Grid.Column="0"
                        Style="{StaticResource ViewerViewportStyle}"
                        Cursor="Hand"
                        MouseLeftButtonDown="ScaraViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="ScaraViewport_MouseLeftButtonUp"
                        MouseMove="ScaraViewport_MouseMove"
                        MouseWheel="ScaraViewport_MouseWheel">
                    <Viewport3D x:Name="ScaraViewport"
                                ClipToBounds="True"
                                SizeChanged="ScaraViewport_SizeChanged"
                                IsHitTestVisible="False" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Style="{StaticResource ViewerSplitterStyle}" />

                <Border Grid.Column="2" Style="{StaticResource ViewerSidebarStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Robot State" Style="{StaticResource ViewerSectionHeadingStyle}" />

                        <Grid Margin="0,18,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
