                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Differential drive robot simulation"
                               Foreground="#CBD5E1"
                               FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
