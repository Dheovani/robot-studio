<Window x:Class="RobotStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RobotStudio"
        Width="1180"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        Background="#111827">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1D4ED8" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1E40AF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#1E293B" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="RobotSelectionView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,22,24,18"
                    Background="#0B1220"
                    BorderBrush="#1E293B"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RobotStudio"
                                   Foreground="#F9FAFB"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock MaxWidth="780"
                                   Margin="0,8,0,0"
                                   Foreground="#CBD5E1"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Text="Choose a robot model to inspect, simulate, and control. The Cartesian robot is available now; future families are shown as planned learning paths." />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Height="34"
                            Margin="24,3,0,0"
                            Padding="12,0"
                            VerticalAlignment="Top"
                            Background="#122033"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#93C5FD"
                                   FontWeight="SemiBold"
                                   Text="Desktop Preview" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Margin="24,22,24,24"
                          VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="RobotCardsPanel" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CartesianViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,14,16,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="RobotStudio"
                               Foreground="#F9FAFB"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Cartesian robot simulation"
                               Foreground="#CBD5E1"
                               FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="104"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="BackToSelectionButton_Click"
                            Content="Robots" />
                    <Button x:Name="PlayPauseButton"
                            Width="96"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="PlayPauseButton_Click"
                            Content="Play" />
                    <Button Width="80"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="ResetButton_Click"
                            Content="Reset" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="340" MinWidth="300" MaxWidth="540" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#0F172A">
                    <Viewport3D x:Name="RobotViewport"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="RobotViewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="RobotViewport_MouseLeftButtonUp"
                                MouseMove="RobotViewport_MouseMove"
                                MouseWheel="RobotViewport_MouseWheel" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              Margin="6,0,0,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#1E293B"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="True" />

                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="14"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#0F172A">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Script"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBox x:Name="ScriptEditorTextBox"
                                     MinHeight="126"
                                     Height="190"
                                     MaxHeight="190"
                                     Margin="0,10,0,10"
                                     Padding="10"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     Foreground="#E5E7EB"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     CaretBrush="#E5E7EB" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Content="Validate"
                                        Click="ValidateScriptButton_Click" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Content="Simulate"
                                        Click="SimulateScriptButton_Click" />
                            </Grid>

                            <TextBlock x:Name="ScriptStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Edit the DSL script and validate it before simulation." />

                            <TextBlock x:Name="CurrentScriptLineText"
                                       Margin="0,0,0,18"
                                       Foreground="#93C5FD"
                                       TextWrapping="Wrap"
                                       Text="Current script line: -" />

                            <TextBlock Text="Manual Control"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Foreground="#94A3B8"
                                           Text="Step mm" />
                                <TextBox x:Name="ManualStepTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,4,6,0"
                                         Padding="8,4"
                                         Text="10"
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Foreground="#94A3B8"
                                           Text="Speed mm/s" />
                                <TextBox x:Name="ManualSpeedTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="30"
                                         Margin="6,4,0,0"
                                         Padding="8,4"
                                         Text="80"
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Margin="0,0,6,6" Content="X-" Click="JogNegativeXButton_Click" />
                                <Button Margin="0,0,6,6" Content="HOME" Click="ManualHomeButton_Click" />
                                <Button Margin="0,0,0,6" Content="X+" Click="JogPositiveXButton_Click" />
                                <Button Margin="0,0,6,6" Content="Y-" Click="JogNegativeYButton_Click" />
                                <Button Margin="0,0,6,6" Content="Stop" Click="StopPlaybackButton_Click" />
                                <Button Margin="0,0,0,6" Content="Y+" Click="JogPositiveYButton_Click" />
                                <Button Margin="0,0,6,0" Content="Z-" Click="JogNegativeZButton_Click" />
                                <Button Margin="0,0,6,0" Content="Reset" Click="ResetButton_Click" />
                                <Button Content="Z+" Click="JogPositiveZButton_Click" />
                            </UniformGrid>

                            <TextBlock x:Name="ManualControlStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Manual actions append DSL commands and resimulate the robot." />

                            <TextBlock Text="Command Console"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CommandConsoleTextBox"
                                         Grid.Column="0"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         Padding="8,5"
                                         FontFamily="Consolas"
                                         Text="MOVE X=100 Y=50 Z=20 SPEED=80"
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB"
                                         KeyDown="CommandConsoleTextBox_KeyDown" />
                                <Button Grid.Column="1"
                                        Content="Execute"
                                        Click="ExecuteCommandButton_Click" />
                            </Grid>

                            <ListBox x:Name="CommandHistoryListBox"
                                     Height="92"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#CBD5E1"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="CommandConsoleStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Execute one DSL command at a time." />

                            <TextBlock Text="Robot State"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <Grid Margin="0,12,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#94A3B8" Text="State" />
                                <TextBlock x:Name="StateValueText" Grid.Row="0" Grid.Column="1" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Position" />
                                <TextBlock x:Name="PositionValueText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Command" />
                                <TextBlock x:Name="CommandValueText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Source" />
                                <TextBlock x:Name="SourceValueText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Time" />
                                <TextBlock x:Name="TimeValueText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Frames" />
                                <TextBlock x:Name="FramesValueText" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                            </Grid>

                            <TextBlock Text="Movement Explanation"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock x:Name="MovementExplanationText"
                                       Margin="0,10,0,20"
                                       Padding="10"
                                       Foreground="#CBD5E1"
                                       Background="#111827"
                                       TextWrapping="Wrap"
                                       Text="Open a robot simulation to inspect command explanations." />

                            <TextBlock Text="Overlays"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <UniformGrid Columns="2" Margin="0,10,0,20">
                                <CheckBox x:Name="ShowWorkspaceCheckBox"
                                          Margin="0,0,8,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Workspace" />
                                <CheckBox x:Name="ShowRailsCheckBox"
                                          Margin="0,0,0,8"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Rails" />
                                <CheckBox x:Name="ShowCarriagesCheckBox"
                                          Margin="0,0,8,0"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="Carriages" />
                                <CheckBox x:Name="ShowToolCheckBox"
                                          Foreground="#CBD5E1"
                                          IsChecked="True"
                                          Checked="OverlayCheckBox_Changed"
                                          Unchecked="OverlayCheckBox_Changed"
                                          Content="TCP / tool" />
                            </UniformGrid>

                            <TextBlock Text="Camera"
                                       Foreground="#F9FAFB"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Azimuth" />
                            <Slider x:Name="AzimuthSlider"
                                    Minimum="-180"
                                    Maximum="180"
                                    ValueChanged="CameraSlider_ValueChanged" />

                            <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Elevation" />
                            <Slider x:Name="ElevationSlider"
                                    Minimum="10"
                                    Maximum="80"
                                    ValueChanged="CameraSlider_ValueChanged" />

                            <TextBlock Margin="0,12,0,4" Foreground="#94A3B8" Text="Zoom" />
                            <Slider x:Name="ZoomSlider"
                                    Minimum="0.6"
                                    Maximum="2.4"
                                    ValueChanged="CameraSlider_ValueChanged" />

                            <WrapPanel Margin="0,14,0,0">
                                <Button Width="82" Margin="0,0,8,8" Content="Iso" Click="IsoViewButton_Click" />
                                <Button Width="82" Margin="0,0,8,8" Content="Front" Click="FrontViewButton_Click" />
                                <Button Width="82" Margin="0,0,0,8" Content="Side" Click="SideViewButton_Click" />
                                <Button Width="82" Margin="0,0,8,0" Content="Top" Click="TopViewButton_Click" />
                                <Button Width="172" Content="Reset Camera" Click="ResetCameraButton_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="48"
                            Margin="0,0,8,0"
                            Content="Prev"
                            Click="PreviousFrameButton_Click" />
                    <Button Width="48"
                            Margin="0,0,12,0"
                            Content="Next"
                            Click="NextFrameButton_Click" />
                    <ComboBox x:Name="PlaybackSpeedComboBox"
                              Width="88"
                              Height="32"
                              VerticalContentAlignment="Center"
                              SelectionChanged="PlaybackSpeedComboBox_SelectionChanged">
                        <ComboBoxItem Content="0.5x" Tag="0.5" />
                        <ComboBoxItem Content="1x" Tag="1" IsSelected="True" />
                        <ComboBoxItem Content="2x" Tag="2" />
                        <ComboBoxItem Content="4x" Tag="4" />
                    </ComboBox>
                </StackPanel>

                <Slider x:Name="TimelineSlider"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Minimum="0"
                        IsSnapToTickEnabled="True"
                        ValueChanged="TimelineSlider_ValueChanged" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#E5E7EB"
                           TextAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
