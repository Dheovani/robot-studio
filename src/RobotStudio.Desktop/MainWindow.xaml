<Window x:Class="RobotStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RobotStudio"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="#111827">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,14,16,10">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="RobotStudio"
                           Foreground="#F9FAFB"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="Cartesian robot simulation"
                           Foreground="#CBD5E1"
                           FontSize="13" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="PlayPauseButton"
                        Width="96"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="PlayPauseButton_Click"
                        Content="Play" />
                <Button Width="80"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="ResetButton_Click"
                        Content="Reset" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="16,0,16,12"
                BorderBrush="#334155"
                BorderThickness="1"
                Background="#0F172A">
            <Viewport3D x:Name="RobotViewport" ClipToBounds="True" />
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Slider x:Name="TimelineSlider"
                    Grid.Column="0"
                    Minimum="0"
                    IsSnapToTickEnabled="True"
                    ValueChanged="TimelineSlider_ValueChanged" />

            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="#E5E7EB"
                       TextAlignment="Right" />
        </Grid>
    </Grid>
</Window>
