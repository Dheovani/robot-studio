<Window x:Class="RobotStudio.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:didactics="clr-namespace:RobotStudio.Desktop.Didactics"
        Title="RobotStudio"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Icon="Assets/RobotStudio.ico"
        Background="{DynamicResource AppBackgroundBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewMouseWheel="MainWindow_PreviewMouseWheel">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B1220" />
        <SolidColorBrush x:Key="SubtlePanelBackgroundBrush" Color="#122033" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F9FAFB" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="BorderBrush" Color="#334155" />
        <SolidColorBrush x:Key="SubtleBorderBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3B82F6" />
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#60A5FA" />
        <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#64748B" />
        <Thickness x:Key="PanelSectionSpacing">0,0,0,10</Thickness>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource ButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ButtonPressedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource SubtleBorderBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Margin" Value="{StaticResource PanelSectionSpacing}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="RobotSelectionView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,22,24,18"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left">
                        <TextBlock Text="RobotStudio"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="30"
                                   FontWeight="SemiBold" />
                        <TextBlock MaxWidth="780"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   Text="Choose a robot model to inspect, simulate, and control. The Cartesian robot is available now; future families are shown as planned learning paths." />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Height="34"
                            Margin="24,3,0,0"
                            Padding="12,0"
                            VerticalAlignment="Top"
                            Background="{StaticResource SubtlePanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="#93C5FD"
                                   FontWeight="SemiBold"
                                   Text="Desktop Preview" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer x:Name="RobotCardsScrollViewer"
                          Grid.Row="1"
                          Margin="24,22,24,24"
                          Background="{StaticResource AppBackgroundBrush}"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="RobotCardsScrollViewer_SizeChanged">
                <UniformGrid x:Name="RobotCardsPanel"
                             Columns="3"
                             FocusVisualStyle="{x:Null}" />
            </ScrollViewer>
        </Grid>

        <Grid x:Name="CartesianViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="16,14,16,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="RobotStudio"
                               Foreground="#F9FAFB"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ViewerSubtitleText"
                               Text="Cartesian robot simulation"
                               Foreground="#CBD5E1"
                               FontSize="13" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Width="104"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="BackToSelectionButton_Click"
                            Content="Robots" />
                    <Button x:Name="PlayPauseButton"
                            Width="96"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="PlayPauseButton_Click"
                            Content="Play" />
                    <Button Width="80"
                            Height="34"
                            Margin="8,0,0,0"
                            Click="ResetButton_Click"
                            Content="Reset" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,0,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="320" MinWidth="280" MaxWidth="540" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#0F172A">
                    <Viewport3D x:Name="RobotViewport"
                                ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonDown="RobotViewport_MouseLeftButtonDown"
                                MouseLeftButtonUp="RobotViewport_MouseLeftButtonUp"
                                MouseMove="RobotViewport_MouseMove"
                                MouseWheel="RobotViewport_MouseWheel" />
                </Border>

                <GridSplitter Grid.Column="1"
                              Width="8"
                              Margin="6,0,0,0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#1E293B"
                              ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Columns"
                              ShowsPreview="True" />

                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="14"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Background="#0F172A">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,10,0">
                            <Expander Header="Script"
                                      IsExpanded="True"
                                      ToolTip="Edit DSL commands before validating or simulating the robot.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Example"
                                               Foreground="#94A3B8" />
                                    <ComboBox x:Name="CartesianExampleComboBox"
                                              Margin="0,4,0,8"
                                              ToolTip="Choose a local teaching example for the active Cartesian-family viewer."
                                              SelectionChanged="CartesianExampleComboBox_SelectionChanged" />
                                    <TextBlock x:Name="CartesianExampleDescriptionText"
                                               Margin="0,0,0,10"
                                               Foreground="#CBD5E1"
                                               TextWrapping="Wrap"
                                               Text="Select an example to load a starter script." />
                                    <Button Margin="0,0,0,10"
                                            Content="Load Example"
                                            ToolTip="Load the selected example into the script editor and regenerate playback."
                                            Click="LoadCartesianExampleButton_Click" />

                                    <Border Height="190"
                                    Margin="0,10,0,10"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer x:Name="ScriptEditorGutterScrollViewer"
                                                  Grid.Column="0"
                                                  Padding="0,10,0,10"
                                                  Background="#0B1220"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  IsHitTestVisible="False">
                                        <StackPanel x:Name="ScriptEditorGutterPanel" />
                                    </ScrollViewer>

                                    <TextBox x:Name="ScriptEditorTextBox"
                                             Grid.Column="1"
                                             Padding="10"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Foreground="#E5E7EB"
                                             Background="#111827"
                                             BorderThickness="0"
                                             CaretBrush="#E5E7EB"
                                             ToolTip="DSL script editor. Supported commands are HOME, MOVE, and WAIT."
                                             ScrollViewer.ScrollChanged="ScriptEditorTextBox_ScrollChanged"
                                             TextChanged="ScriptEditorTextBox_TextChanged" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Content="Validate"
                                        ToolTip="Parse the DSL script and check Cartesian limits without changing playback."
                                        Click="ValidateScriptButton_Click" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Content="Simulate"
                                        ToolTip="Generate a deterministic playback snapshot from the current valid script."
                                        Click="SimulateScriptButton_Click" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Margin="0,0,6,0"
                                        Content="Load Script"
                                        ToolTip="Load a DSL script from a local text file."
                                        Click="LoadCartesianScriptButton_Click" />
                                <Button Grid.Column="1"
                                        Margin="6,0,0,0"
                                        Content="Save Script"
                                        ToolTip="Save the current DSL script to a local text file."
                                        Click="SaveCartesianScriptButton_Click" />
                            </Grid>

                            <TextBlock x:Name="ScriptStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Edit the DSL script and validate it before simulation." />

                            <TextBlock x:Name="CurrentScriptLineText"
                                       Margin="0,0,0,18"
                                       Foreground="#93C5FD"
                                       TextWrapping="Wrap"
                                       Text="Current script line: -" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Manual Control"
                                      IsExpanded="True"
                                      ToolTip="Jog the simulated Cartesian robot by appending DSL commands.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Foreground="#94A3B8"
                                           Text="Step mm" />
                                <TextBox x:Name="ManualStepTextBox"
                                         Grid.Row="1"
                                         Grid.Column="0"
                                         Height="30"
                                         Margin="0,4,6,0"
                                         Padding="8,4"
                                         Text="10"
                                         ToolTip="Distance applied by each jog command, in millimeters."
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Foreground="#94A3B8"
                                           Text="Speed mm/s" />
                                <TextBox x:Name="ManualSpeedTextBox"
                                         Grid.Row="1"
                                         Grid.Column="1"
                                         Height="30"
                                         Margin="6,4,0,0"
                                         Padding="8,4"
                                         Text="80"
                                         ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB" />
                            </Grid>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Margin="0,0,6,6" Content="X-" ToolTip="Move one step in the negative X direction." Click="JogNegativeXButton_Click" />
                                <Button Margin="0,0,6,6" Content="HOME" ToolTip="{x:Static didactics:DidacticTooltipCatalog.Homing}" Click="ManualHomeButton_Click" />
                                <Button Margin="0,0,0,6" Content="X+" ToolTip="Move one step in the positive X direction." Click="JogPositiveXButton_Click" />
                                <Button Margin="0,0,6,6" Content="Y-" ToolTip="Move one step in the negative Y direction." Click="JogNegativeYButton_Click" />
                                <Button Margin="0,0,6,6" Content="Stop" ToolTip="Stop visual playback without changing the simulated command sequence." Click="StopPlaybackButton_Click" />
                                <Button Margin="0,0,0,6" Content="Y+" ToolTip="Move one step in the positive Y direction." Click="JogPositiveYButton_Click" />
                                <Button x:Name="JogNegativeZButton" Margin="0,0,6,0" Content="Z-" ToolTip="Move one step in the negative Z direction." Click="JogNegativeZButton_Click" />
                                <Button Margin="0,0,6,0" Content="Reset" ToolTip="Return playback to the first generated frame." Click="ResetButton_Click" />
                                <Button x:Name="JogPositiveZButton" Content="Z+" ToolTip="Move one step in the positive Z direction." Click="JogPositiveZButton_Click" />
                            </UniformGrid>

                            <TextBlock x:Name="ManualControlStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Manual actions append DSL commands and resimulate the robot." />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Command Console"
                                      IsExpanded="False"
                                      ToolTip="Execute one DSL command at a time and append valid commands to the script.">
                                <StackPanel Margin="0,10,0,0">
                                    <Grid Margin="0,10,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="86" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="CommandConsoleTextBox"
                                         Grid.Column="0"
                                         Height="32"
                                         Margin="0,0,8,0"
                                         Padding="8,5"
                                         FontFamily="Consolas"
                                         Text="MOVE X=100 Y=50 Z=20 SPEED=80"
                                         ToolTip="Type one DSL command. Press Enter or Execute to validate and append it."
                                         Foreground="#E5E7EB"
                                         Background="#111827"
                                         BorderBrush="#334155"
                                         CaretBrush="#E5E7EB"
                                         KeyDown="CommandConsoleTextBox_KeyDown" />
                                <Button Grid.Column="1"
                                        Content="Execute"
                                        ToolTip="Validate and execute the command currently typed in the console."
                                        Click="ExecuteCommandButton_Click" />
                            </Grid>

                            <ListBox x:Name="CommandHistoryListBox"
                                     Height="92"
                                     Margin="0,0,0,10"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#CBD5E1"
                                     Background="#111827"
                                     BorderBrush="#334155"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                            <TextBlock x:Name="CommandConsoleStatusText"
                                       Margin="0,0,0,18"
                                       Foreground="#94A3B8"
                                       TextWrapping="Wrap"
                                       Text="Execute one DSL command at a time." />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Robot State"
                                      IsExpanded="True"
                                      ToolTip="{x:Static didactics:DidacticTooltipCatalog.RobotState}">
                                <Grid Margin="0,12,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#94A3B8" Text="State" />
                                <TextBlock x:Name="StateValueText" Grid.Row="0" Grid.Column="1" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Position" />
                                <TextBlock x:Name="PositionValueText" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Command" />
                                <TextBlock x:Name="CommandValueText" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Source" />
                                <TextBlock x:Name="SourceValueText" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Time" />
                                <TextBlock x:Name="TimeValueText" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8,0,0" Foreground="#94A3B8" Text="Frames" />
                                <TextBlock x:Name="FramesValueText" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Foreground="#E5E7EB" TextAlignment="Right" />
                            </Grid>
                            </Expander>

                            <Expander Header="Charts"
                                      IsExpanded="False"
                                      ToolTip="Inspect position, velocity, state, and distance values derived from playback frames.">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Position Chart"
                                               Foreground="#F9FAFB"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <Border Height="156"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="PositionChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="PositionChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="3" Margin="0,0,0,20">
                                <TextBlock Foreground="#F87171" Text="X axis" />
                                <TextBlock Foreground="#22C55E" Text="Y axis" />
                                <TextBlock Foreground="#60A5FA" Text="Z axis" />
                            </UniformGrid>

                                    <TextBlock Text="Velocity Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="VelocityChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="#94A3B8"
                                       Text="Effective velocity in mm/s from playback samples."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="Requested vs Effective"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="VelocityComparisonChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="VelocityComparisonChartCanvas_SizeChanged" />
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <TextBlock Foreground="#38BDF8" Text="Requested" ToolTip="{x:Static didactics:DidacticTooltipCatalog.RequestedVelocity}" />
                                <TextBlock Foreground="#FACC15" Text="Effective" ToolTip="{x:Static didactics:DidacticTooltipCatalog.EffectiveVelocity}" />
                            </UniformGrid>

                                    <TextBlock Text="Distance Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="128"
                                    Margin="0,10,0,8"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="DistanceChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="DistanceChartCanvas_SizeChanged" />
                            </Border>

                            <TextBlock Margin="0,0,0,20"
                                       Foreground="#94A3B8"
                                       Text="Accumulated TCP distance in millimeters."
                                       ToolTip="{x:Static didactics:DidacticTooltipCatalog.ToolCenterPoint}"
                                       TextWrapping="Wrap" />

                                    <TextBlock Text="State Chart"
                                       Foreground="#F9FAFB"
                                       FontSize="14"
                                       FontWeight="SemiBold" />

                            <Border Height="168"
                                    Margin="0,10,0,20"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    Background="#111827">
                                <Canvas x:Name="StateChartCanvas"
                                        ClipToBounds="True"
                                        SizeChanged="StateChartCanvas_SizeChanged" />
                            </Border>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Movement Explanation"
                                      IsExpanded="False"
                                      ToolTip="Read a didactic explanation of the current command and movement constraints.">
                                <TextBlock x:Name="MovementExplanationText"
                                       Margin="0,10,0,20"
                                       Padding="10"
                                       Foreground="#CBD5E1"
                                       Background="#111827"
                                       TextWrapping="Wrap"
