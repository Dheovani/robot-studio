                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Width="48"
                            Margin="0,0,8,0"
                            Content="Prev"
                            ToolTip="Move one playback frame backward."
                            Click="PreviousFrameButton_Click" />
                    <Button Width="48"
                            Margin="0,0,12,0"
                            Content="Next"
                            ToolTip="Move one playback frame forward."
                            Click="NextFrameButton_Click" />
