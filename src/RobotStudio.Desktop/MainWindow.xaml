                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#E5E7EB"
                           TextAlignment="Right" />
            </Grid>
        </Grid>

        <Grid x:Name="DifferentialDriveViewerView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
