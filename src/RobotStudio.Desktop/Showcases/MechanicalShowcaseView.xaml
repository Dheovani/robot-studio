<UserControl x:Class="RobotStudio.Desktop.Showcases.MechanicalShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             xmlns:viewers="clr-namespace:RobotStudio.Desktop.Viewers"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <viewers:ViewerHeader x:Name="ShowcaseHeader" Grid.Row="0">
            <viewers:ViewerHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource ViewerNavigationButtonStyle}"
                            Content="{DynamicResource Common.Robots}"
                            ToolTip="Return to the robot catalog."
                            Click="BackButton_Click" />
                    <Button Style="{DynamicResource ViewerToolbarButtonStyle}"
                            Content="{DynamicResource Common.Play}"
                            Click="PlayButton_Click" />
                    <Button Style="{DynamicResource ViewerToolbarButtonStyle}"
                            Content="{DynamicResource Common.Reset}"
                            Click="ResetButton_Click" />
                </StackPanel>
            </viewers:ViewerHeader.Actions>
        </viewers:ViewerHeader>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ShowcaseViewportHost"
                    Grid.Column="0"
                    ClipToBounds="True"
                    Cursor="Hand"
                    Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MouseDown="ShowcaseViewportHost_MouseDown"
                    MouseUp="ShowcaseViewportHost_MouseUp"
                    MouseMove="ShowcaseViewportHost_MouseMove"
                    MouseWheel="ShowcaseViewportHost_MouseWheel">
                <hx:Viewport3DX x:Name="ShowcaseViewport"
                               BackgroundColor="{StaticResource ViewportBackgroundColor}"
                               EnableMouseButtonHitTest="True"
                               EnableSwapChainRendering="False"
                               FXAALevel="Low"
                               ModelUpDirection="0,0,1"
                               OITRenderMode="SinglePassWeighted"
                               ShowCoordinateSystem="True"
                               ShowViewCube="False"
                               UseDefaultGestures="False">
                    <hx:AmbientLight3D Color="{StaticResource AmbientLightColor}" />
                    <hx:DirectionalLight3D x:Name="CameraKeyLight"
                                           Color="{StaticResource KeyLightColor}"
                                           Direction="-1,1,-2" />
                    <hx:DirectionalLight3D Color="{StaticResource FillLightColor}"
                                           Direction="1,-1,-1" />
                </hx:Viewport3DX>
            </Border>

            <Border Grid.Column="2"
                    Padding="{DynamicResource PanelPadding}"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource PanelCornerRadius}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                   Text="{DynamicResource Showcase.ViewLayer}" />
                        <ComboBox x:Name="TeachingViewComboBox"
                                  Margin="0,10,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="TeachingViewComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="{DynamicResource SectionSpacing}">
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                   Text="{DynamicResource Showcase.Demonstration}" />
                        <ComboBox x:Name="DemonstrationComboBox"
                                  Margin="0,10,0,10"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="DemonstrationComboBox_SelectionChanged" />
                        <TextBlock x:Name="DemonstrationDescriptionText"
                                   Style="{DynamicResource MetadataTextStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,2,0,18">
                        <ProgressBar x:Name="DemonstrationProgressBar"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="1" />
                        <TextBlock x:Name="DemonstrationTimeText"
                                   Margin="0,6,0,0"
                                   Style="{DynamicResource MetadataTextStyle}"
                                   Text="0 / 0 s" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Style="{DynamicResource SectionTitleTextStyle}"
                                   Text="{DynamicResource Showcase.SelectedComponent}" />
                        <TextBlock x:Name="PartNameText"
                                   Margin="0,12,0,0"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.SelectComponent}" />
                        <TextBlock x:Name="PartKindText"
                                   Margin="0,3,0,0"
                                   Style="{DynamicResource MetadataTextStyle}" />
                        <TextBlock x:Name="PartRelationshipText"
                                   Margin="0,3,0,0"
                                   Style="{DynamicResource MetadataTextStyle}" />
                        <TextBlock Margin="0,16,0,4"
                                   Style="{DynamicResource FieldLabelTextStyle}"
                                   Text="{DynamicResource Showcase.Function}" />
                        <TextBlock x:Name="PartFunctionText"
                                   Style="{DynamicResource BodyTextStyle}" />
                        <TextBlock Margin="0,16,0,4"
                                   Style="{DynamicResource FieldLabelTextStyle}"
                                   Text="{DynamicResource Showcase.Movement}" />
                        <TextBlock x:Name="PartMovementText"
                                   Style="{DynamicResource BodyTextStyle}" />
                        <Border Margin="0,20,0,0"
                                Padding="10"
                                Background="{StaticResource MechanicalInfoSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource PanelCornerRadius}">
                            <TextBlock x:Name="TeachingViewDescriptionText"
                                       Style="{DynamicResource MetadataTextStyle}"
                                       Text="{DynamicResource Showcase.CompleteMachine}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
