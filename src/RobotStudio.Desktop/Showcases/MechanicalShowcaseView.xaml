<UserControl x:Class="RobotStudio.Desktop.Showcases.MechanicalShowcaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Style="{DynamicResource ViewerHeaderStyle}">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="ShowcaseTitleText"
                           Style="{DynamicResource ViewerTitleStyle}" />
                <TextBlock x:Name="ShowcaseSubtitleText"
                           Style="{DynamicResource ViewerSubtitleStyle}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Style="{DynamicResource ViewerNavigationButtonStyle}"
                        Content="{DynamicResource Common.Robots}"
                        ToolTip="Return to the robot catalog."
                        Click="BackButton_Click" />
                <Button x:Name="HeaderPlayButton"
                        Style="{DynamicResource ViewerToolbarButtonStyle}"
                        Content="{DynamicResource Common.Play}"
                        Click="PlayButton_Click" />
                <Button Style="{DynamicResource ViewerToolbarButtonStyle}"
                        Content="{DynamicResource Common.Reset}"
                        Click="ResetButton_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ShowcaseViewportHost"
                    Grid.Column="0"
                    ClipToBounds="True"
                    Cursor="Hand"
                    Background="#0B1220"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MouseDown="ShowcaseViewportHost_MouseDown"
                    MouseUp="ShowcaseViewportHost_MouseUp"
                    MouseMove="ShowcaseViewportHost_MouseMove"
                    MouseWheel="ShowcaseViewportHost_MouseWheel">
                <hx:Viewport3DX x:Name="ShowcaseViewport"
                               BackgroundColor="#0B1220"
                               EnableMouseButtonHitTest="True"
                               EnableSwapChainRendering="False"
                               FXAALevel="Low"
                               ModelUpDirection="0,0,1"
                               OITRenderMode="SinglePassWeighted"
                               ShowCoordinateSystem="True"
                               ShowViewCube="False"
                               UseDefaultGestures="False">
                    <hx:AmbientLight3D Color="#748096" />
                    <hx:DirectionalLight3D x:Name="CameraKeyLight"
                                           Color="#FFF4E6"
                                           Direction="-1,1,-2" />
                    <hx:DirectionalLight3D Color="#7EA6D8"
                                           Direction="1,-1,-1" />
                </hx:Viewport3DX>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.ViewLayer}" />
                        <ComboBox x:Name="TeachingViewComboBox"
                                  Margin="0,10,0,0"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="TeachingViewComboBox_SelectionChanged" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.Demonstration}" />
                        <ComboBox x:Name="DemonstrationComboBox"
                                  Margin="0,10,0,10"
                                  DisplayMemberPath="Name"
                                  SelectionChanged="DemonstrationComboBox_SelectionChanged" />
                        <TextBlock x:Name="DemonstrationDescriptionText"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,2,0,18">
                        <ProgressBar x:Name="DemonstrationProgressBar"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="1" />
                        <TextBlock x:Name="DemonstrationTimeText"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Text="0 / 0 s" />
                    </StackPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.SelectedComponent}" />
                        <TextBlock x:Name="PartNameText"
                                   Margin="0,12,0,0"
                                   Foreground="#93C5FD"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.SelectComponent}" />
                        <TextBlock x:Name="PartKindText"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock x:Name="PartRelationshipText"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.Function}" />
                        <TextBlock x:Name="PartFunctionText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,4"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Showcase.Movement}" />
                        <TextBlock x:Name="PartMovementText"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,20,0,0"
                                Padding="10"
                                Background="#182235"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="TeachingViewDescriptionText"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Text="{DynamicResource Showcase.CompleteMachine}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
